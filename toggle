#!/usr/bin/env bash
set -euo pipefail

project_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
kitty_bin="$HOME/.local/kitty.app/bin"
state_file="${XDG_STATE_HOME:-$HOME/.local/state}/kitty-dropdown/controls.conf"

if [[ ! -x "$kitty_bin/kitten" ]]; then
	printf 'Install native Kitty in %s first.\n' "$HOME/.local/kitty.app" >&2
	exit 1
fi

export PATH="$kitty_bin:$PATH"
# An existing Kitty terminal can point kittens at an older installation.
unset KITTY_INSTALLATION_DIR KITTY_PID
state_config=()
if [[ -f "$state_file" ]]; then
	state_config=(--config "$state_file")
fi
cd -- "$HOME"
exec "$kitty_bin/kitten" quick-access-terminal \
	--config "$project_dir/quick-access-terminal.conf" \
	"${state_config[@]}" \
	--instance-group kitty-dropdown \
	--override "kitty_override=watcher=$project_dir/controls.py" \
	--override "kitty_override=watcher=$project_dir/desktop.py" \
	"$@" \
	--detach
